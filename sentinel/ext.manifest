name: "Sentinel"

platforms:
    x86_64-osx:
        context:
            frameworks: ["Foundation", "Metal", "OpenGL"]
    arm64-osx:
        context:
            frameworks: ["Foundation", "Metal", "OpenGL"]
    x86_64-win32:
        context:
            libs: ["advapi32", "dxgi", "opengl32"]
    x86-win32:
        context:
            libs: ["advapi32", "dxgi", "opengl32"]
