[bootstrap]
main_collection = /example/test.collectionc

[display]
width = 960
height = 640

[script]
shared_state = 1

[project]
title = sentinel_example
version = 1.0.0

[library]
include_dirs = sentinel

[html5]
scale_mode = fit
cssfile = /builtins/manifests/web/dark_theme.css

[sentinel]
sentry_dsn = https://55836b9c3acd4fdf8cc71c5ec660cae9@app.glitchtip.com/27061
sentry_dsn_html5 = https://55836b9c3acd4fdf8cc71c5ec660cae9@app.glitchtip.com/27061
sentry_environment = sandbox
sentry_enabled = 1
sentry_debug = 1
sentry_dry_run = 0
sentry_send_timeout = 10
sentry_load_previous_crash = 1
sentry_collect_gpu_info = 1
sentry_gpu_extensions_limit = 128

[input]
game_binding = /builtins/input/all.input_bindingc

[native_extension]
app_manifest = /gpu.appmanifest
